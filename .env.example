APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB (XAMPP). Skema diurus manual dalam HeidiSQL: jangan jalankan php artisan migrate.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dms_pkink_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true bila diakses melalui HTTPS sahaja (demo melalui terowong / produksi); biar kosong untuk http://localhost
#SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OCR (Tesseract + Poppler): laluan PENUH ke .exe di Windows/Herd
OCR_TESSERACT_BIN="C:/Program Files/Tesseract-OCR/tesseract.exe"
OCR_PDFTOPPM_BIN="C:/poppler/Library/bin/pdftoppm.exe"
OCR_BAHASA=msa+eng
OCR_HAD_MASA=300
# Buang garisan kotak/jadual sebelum OCR (pilih hasil terbaik setiap halaman)
OCR_BUANG_GARISAN=true

# AI tempatan (Ollama). Lihat config/services.php untuk penerangan setiap tetapan.
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="sea-lion-local"
OLLAMA_NUM_GPU=99
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HAD_MASA=180
# Laluan hibrid: muka surat dengan skor Tesseract < ambang dibaca semula oleh model penglihatan
# tempatan (tulisan tangan). Perlu: ollama pull glm-ocr:q8_0
OCR_VLM_AKTIF=true
OCR_VLM_MODEL=glm-ocr:q8_0
OCR_VLM_AMBANG=80

# Sandaran harian (php artisan sandaran:jalan, dijadualkan 12:30): DB + fail imbasan dalam satu zip.
# Laluan penuh mysqldump.exe kerana Herd tidak nampak PATH Windows.
SANDARAN_MYSQLDUMP_BIN="C:/xampp/mysql/bin/mysqldump.exe"
# Lalai: storage/app/sandaran. SANDARAN_SALINAN = salinan kedua di luar projek (cth. OneDrive).
#SANDARAN_FOLDER=
SANDARAN_SALINAN="C:/Users/NAMA/OneDrive/Sandaran DMS PKINK"
SANDARAN_SIMPAN_HARI=14

# Notifikasi peranti (Web Push). Jana kunci: php artisan webpush:vapid
# Windows: PHP perlukan pemboleh ubah persekitaran OPENSSL_CONF (cth. C:/Users/NAMA/.config/herd/bin/php83/extras/ssl/openssl.cnf)
# untuk mencipta kunci EC; tanpanya penjanaan kunci & penghantaran Web Push gagal (README 10).
VAPID_SUBJECT="mailto:pentadbir@contoh.gov.my"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Notifikasi emel (P2): mati secara lalai; hidupkan semasa serahan bila akaun sebenar digunakan
NOTIFIKASI_EMEL=false

# 2FA (P13): wajib bagi SUPERADMIN/ADMIN bila true. Kekal false hingga serahan (Fasa H)
DUA_FAKTOR_WAJIB=false

# Tera air salinan muat turun (P11): laluan penuh fon TrueType; kosong = Arial Bold / DejaVu
TERA_AIR_FON=
