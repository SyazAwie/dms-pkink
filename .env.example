# =============================================================================
# Sistem Arkib Digital (DMS) PKINK - tetapan pelayan
#
# Salin fail ini kepada .env, kemudian isi setiap nilai bertanda <ISI>.
# Selepas mengubah .env:  php artisan config:clear  (atau config:cache di produksi)
# Panduan penuh: docs/PANDUAN_PEMASANGAN.pdf
#
# Laluan program: contoh diberi bagi Windows dan Linux; alih keluar tanda # pada baris yang sesuai.
# =============================================================================

# --- Aplikasi -----------------------------------------------------------------
APP_NAME="Sistem Arkib PKINK"
# Nama organisasi pemilik (kepala bercetak borang; AI tidak mengisinya sebagai nilai)
NAMA_ORGANISASI="Perbadanan Kemajuan Iktisad Negeri Kelantan"
APP_ENV=production
# Jana sekali selepas fail ini disalin:  php artisan key:generate   (tidak boleh ditukar selepas data wujud)
APP_KEY=
# MESTI false pada pelayan yang diakses pengguna (true mendedahkan butiran ralat)
APP_DEBUG=false
# Alamat penuh sistem seperti ditaip pengguna (digunakan dalam emel, kod QR slip dan notifikasi)
APP_URL=https://<ISI>

APP_TIMEZONE=Asia/Kuala_Lumpur
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Pangkalan data (MySQL 8 / MariaDB 10.4+) ---------------------------------
# Import database/dms_pkink.sql ke pangkalan data kosong. Arahan php artisan migrate TIDAK BOLEH dijalankan:
# skema diurus melalui skrip SQL, bukan migration Laravel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dms_pkink
# Gunakan pengguna khas dengan keistimewaan terhad pada DB ini sahaja (bukan root)
DB_USERNAME=<ISI>
DB_PASSWORD=<ISI>

# --- Sesi, cache dan baris gilir (queue) -----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true bila sistem diakses melalui HTTPS (disyorkan). false hanya untuk ujian melalui http://
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database
# Queue OCR/AI: lebih lama daripada OCR_HAD_MASA supaya kerja panjang tidak diambil semula
DB_QUEUE_RETRY_AFTER=660

# --- Emel (SMTP rasmi PKINK) -------------------------------------------------------
# log = emel tidak dihantar (ditulis ke storage/logs). smtp = hantar sebenar.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<ISI>
MAIL_PORT=587
MAIL_USERNAME=<ISI>
MAIL_PASSWORD=<ISI>
MAIL_FROM_ADDRESS="<ISI>"
MAIL_FROM_NAME="${APP_NAME}"
# Notifikasi emel aliran kelulusan (pemohon & pegawai). Lupa kata laluan & pendaftaran sentiasa menghantar emel.
NOTIFIKASI_EMEL=true

# --- OCR (Tesseract + Poppler) -----------------------------------------------------
# Windows:
#OCR_TESSERACT_BIN="C:/Program Files/Tesseract-OCR/tesseract.exe"
#OCR_PDFTOPPM_BIN="C:/poppler/Library/bin/pdftoppm.exe"
# Linux:
#OCR_TESSERACT_BIN=/usr/bin/tesseract
#OCR_PDFTOPPM_BIN=/usr/bin/pdftoppm
OCR_BAHASA=msa+eng
OCR_HAD_MASA=300
# Bila pekerja latar OCR tidak berjalan (OCR segerak): satu analisis pada satu masa, yang lain menunggu N saat
OCR_TUNGGU_GILIRAN=120
OCR_BUANG_GARISAN=true
# Tanda visual borang (perkataan dipotong, kotak ✓) untuk AI
OCR_TANDA_VISUAL=true
# Beza imej templat borang kosong (yang sudah disusun) dengan imbasan
OCR_BEZA_TEMPLAT=true
# Laluan hibrid tulisan tangan: muka surat dengan skor Tesseract < ambang dibaca semula oleh model
# penglihatan tempatan (perlu: ollama pull glm-ocr:q8_0). false = Tesseract sahaja.
OCR_VLM_AKTIF=true
OCR_VLM_MODEL=glm-ocr:q8_0
OCR_VLM_AMBANG=80

# --- AI tempatan (Ollama) ------------------------------------------------------------
# Model SEA-LION didaftarkan dalam Ollama sebagai sea-lion-local (lihat Panduan Pemasangan).
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="sea-lion-local"
# 99 = muatkan seluruh model ke GPU (perlu GPU >= 6GB). Tanpa GPU: alih keluar baris ini.
OLLAMA_NUM_GPU=99
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HAD_MASA=180
# Kesilapan AI yang dibetulkan staf dimasukkan ke prompt kategori yang sama
OLLAMA_FEW_SHOT=true

# --- Sandaran (php artisan sandaran:jalan, dijadualkan setiap hari) --------------------
# false bila pelayan sudah mempunyai sandaran sendiri yang diuji (contohnya snapshot mesin maya)
SANDARAN_AKTIF=true
# Masa sandaran harian (HH:MM), pilih waktu tidak sibuk
SANDARAN_MASA=02:00
# Windows:
#SANDARAN_MYSQLDUMP_BIN="C:/xampp/mysql/bin/mysqldump.exe"
#SANDARAN_MYSQL_BIN="C:/xampp/mysql/bin/mysql.exe"
# Linux:
#SANDARAN_MYSQLDUMP_BIN=/usr/bin/mysqldump
#SANDARAN_MYSQL_BIN=/usr/bin/mysql
# Folder sandaran (lalai storage/app/sandaran). Disyorkan cakera/NAS berasingan.
#SANDARAN_FOLDER=
# Salinan kedua di lokasi lain (pilihan)
#SANDARAN_SALINAN=
# Simpanan: semua sandaran N hari terakhir, kemudian satu setiap minggu / bulan (0 = tiada)
SANDARAN_SIMPAN_HARI=14
SANDARAN_SIMPAN_MINGGU=8
SANDARAN_SIMPAN_BULAN=6
# Zip sandaran disulitkan AES-256. SIMPAN kata laluan ini DI LUAR pelayan; tanpanya sandaran
# tidak boleh dibuka. Pulih: php artisan sandaran:pulih. WAJIB diisi di produksi (kosong = tidak disulitkan).
SANDARAN_KATA_LALUAN=

# --- Notifikasi peranti (Web Push) ----------------------------------------------------
# Jana kunci sekali:  php artisan webpush:vapid   (perlukan HTTPS untuk telefon)
# Windows: PHP memerlukan pemboleh ubah persekitaran OPENSSL_CONF (lihat Panduan Pemasangan).
VAPID_SUBJECT="mailto:<ISI emel pentadbir>"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Keselamatan ---------------------------------------------------------------------
# 2FA (aplikasi pengesah) wajib bagi SUPERADMIN/ADMIN
DUA_FAKTOR_WAJIB=true
# Pemeriksaan fail muat naik. ANTIVIRUS_BIN kosong = Windows Defender (MpCmdRun.exe) atau
# clamdscan/clamscan (Linux). ANTIVIRUS_WAJIB=true: tolak muat naik bila imbasan tidak dapat dibuat.
ANTIVIRUS_BIN=
ANTIVIRUS_WAJIB=true
KESELAMATAN_MAKS_MUKA_SURAT=50
KESELAMATAN_MAKS_PIKSEL=40000000
KESELAMATAN_MIN_RUANG_MB=1024
# IP yang tidak disekat secara automatik (dipisahkan dengan koma), contohnya IP awam pejabat yang dikongsi ramai staf
KESELAMATAN_IP_DIPERCAYAI=

# --- Lain-lain -------------------------------------------------------------------------
# Tera air salinan muat turun: laluan penuh fon TrueType; kosong = Arial Bold / DejaVu
TERA_AIR_FON=
